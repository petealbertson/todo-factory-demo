<p style="color: green"><%= notice %></p>

<% content_for :title, "Todos" %>

<% todos = @todos.to_a %>

<h1>Todos</h1>

<nav aria-label="Filter by priority">
  <%= link_to "All", todos_path(priority: nil) %> |
  <%= link_to "High", todos_path(priority: "high") %> |
  <%= link_to "Medium", todos_path(priority: "medium") %> |
  <%= link_to "Low", todos_path(priority: "low") %>
</nav>

<p>Completed: <%= todos.count(&:completed?) %> of <%= todos.size %></p>

<div id="todos">
  <% todos.each do |todo| %>
    <%= render todo %>
    <p>
      <%= link_to "Show this todo", todo %>
    </p>
  <% end %>
</div>

<%= link_to "New todo", new_todo_path %>
